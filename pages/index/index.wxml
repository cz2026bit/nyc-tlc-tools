<view class="page">
  <view class="top-band">
    <view class="title">纽约 TLC 工具箱</view>
    <view class="subtitle">选择功能模块，后续新工具会继续添加在这里</view>
  </view>

  <view wx:if="{{!currentModule}}" class="home-grid">
    <button class="feature-card" data-module="tlc" bindtap="openModule">
      <view class="feature-icon">T</view>
      <view class="feature-title">查 TLC 违章</view>
      <view class="feature-desc">输入车牌号，查询 TLC 车辆资料和违章记录</view>
    </button>
    <button class="feature-card" data-module="receipt" bindtap="openModule">
      <view class="feature-icon">$</view>
      <view class="feature-title">票据训练示例</view>
      <view class="feature-desc">上传图片，输入金额，生成带标记的训练示例图</view>
    </button>
  </view>

  <block wx:if="{{currentModule === 'tlc'}}">
  <view class="module-bar">
    <button class="back-button" bindtap="backHome">‹ 返回首页</button>
    <view class="module-name">查 TLC 违章</view>
  </view>

  <view class="search-panel">
    <view class="plate-row">
      <input
        class="plate-input"
        value="{{plate}}"
        maxlength="12"
        confirm-type="search"
        placeholder="例如 T702139C"
        bindinput="onPlateInput"
        bindconfirm="search"
      />
      <button class="search-button" loading="{{loading}}" bindtap="search">查询</button>
    </view>
    <view class="hint">数据来自 NYC Open Data。上线前请在微信公众平台配置 request 合法域名：data.cityofnewyork.us。</view>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>

  <view wx:if="{{hasSearched && !loading}}" class="summary">
    <view class="summary-item">
      <view class="summary-value">{{vehicleCount}}</view>
      <view class="summary-label">TLC 车辆记录</view>
    </view>
    <view class="summary-item">
      <view class="summary-value">{{violationCount}}</view>
      <view class="summary-label">违章记录</view>
    </view>
    <view class="summary-item">
      <view class="summary-value">${{totalDue}}</view>
      <view class="summary-label">未付金额</view>
    </view>
  </view>

  <view wx:if="{{vehicles.length}}" class="section">
    <view class="section-title">TLC 车辆信息</view>
    <view wx:for="{{vehicles}}" wx:key="key" class="card">
      <view class="card-head">
        <view>
          <view class="card-title">{{item.plate}}</view>
          <view class="card-subtitle">{{item.source}}</view>
        </view>
        <view class="status {{item.activeClass}}">{{item.status}}</view>
      </view>
      <view class="info-grid">
        <view class="info-cell">
          <view class="info-label">TLC 牌照号</view>
          <view class="info-value">{{item.licenseNumber}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">车主 / 公司</view>
          <view class="info-value">{{item.name}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">车辆类型</view>
          <view class="info-value">{{item.vehicleType}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">车辆年份</view>
          <view class="info-value">{{item.vehicleYear}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">VIN</view>
          <view class="info-value">{{item.vin}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">License 类型</view>
          <view class="info-value">{{item.licenseType}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 编号</view>
          <view class="info-value">{{item.baseNumber}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 名称</view>
          <view class="info-value">{{item.baseName}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 类型</view>
          <view class="info-value">{{item.baseType}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 电话</view>
          <view class="info-value">{{item.basePhone}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 地址</view>
          <view class="info-value">{{item.baseAddress}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">Base 网站 / 邮箱</view>
          <view class="info-value">{{item.baseWebsite}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">到期日期</view>
          <view class="info-value">{{item.expirationDate}}</view>
        </view>
        <view class="info-cell">
          <view class="info-label">最后更新</view>
          <view class="info-value">{{item.updated}}</view>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{violations.length}}" class="section">
    <view class="section-title">违章记录</view>
    <view wx:for="{{violations}}" wx:key="summonsNumber" class="card violation-card">
      <view class="card-head">
        <view>
          <view class="card-title">{{item.violation}}</view>
          <view class="card-subtitle">罚单号 {{item.summonsNumber}}</view>
        </view>
        <view class="money">${{item.amountDue}}</view>
      </view>
      <view class="detail-list">
        <view class="detail-row">
          <text>日期</text>
          <text>{{item.issueDate}} {{item.violationTime}}</text>
        </view>
        <view class="detail-row">
          <text>地点</text>
          <text>{{item.county}} / Precinct {{item.precinct}}</text>
        </view>
        <view class="detail-row">
          <text>机构</text>
          <text>{{item.agency}}</text>
        </view>
        <view class="detail-row">
          <text>罚金</text>
          <text>Fine ${{item.fineAmount}} · Penalty ${{item.penaltyAmount}} · Paid ${{item.paymentAmount}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{hasSearched && !loading && !vehicles.length && !violations.length && !error}}" class="empty">
    <view class="empty-title">没有找到公开记录</view>
    <view class="empty-text">请确认车牌号拼写，或稍后再试。NYC Open Data 更新可能有延迟。</view>
  </view>
  </block>

  <block wx:if="{{currentModule === 'receipt'}}">
  <view class="module-bar">
    <button class="back-button" bindtap="backHome">‹ 返回首页</button>
    <view class="module-name">票据训练示例</view>
  </view>

  <view class="section receipt-section">
    <view class="section-title">票据训练示例生成</view>
    <view class="card receipt-card">
      <view class="card-head">
        <view>
          <view class="card-title">上传票据图片</view>
          <view class="card-subtitle">只输入最终金额，图片会同步显示带训练标记的示例说明</view>
        </view>
        <button class="mini-button" bindtap="chooseReceiptImage">上传</button>
      </view>

      <view class="receipt-preview">
        <view wx:if="{{receiptImage}}" class="receipt-image-wrap">
          <image class="receipt-image" src="{{receiptImage}}" mode="aspectFit" />
          <view class="receipt-overlay">{{receiptOverlayText}}</view>
          <view class="receipt-watermark">TRAINING SAMPLE</view>
        </view>
        <view wx:else class="receipt-placeholder">图片只在本机预览，不会上传服务器，仅用于训练示例生成</view>
      </view>

      <view class="receipt-form">
        <view class="field-label">最终金额</view>
        <view class="target-row single-target-row">
          <input
            class="money-input"
            type="digit"
            value="{{receiptTargetTotal}}"
            placeholder="例如 85.00"
            bindinput="onReceiptTargetInput"
          />
        </view>

        <view class="amount-list hidden-control">
          <view wx:for="{{receiptAmounts}}" wx:key="id" class="amount-row">
            <view class="amount-index">{{index + 1}}</view>
            <input
              class="money-input"
              type="digit"
              value="{{item.value}}"
              data-index="{{index}}"
              bindinput="onReceiptAmountInput"
            />
            <button class="remove-button" data-index="{{index}}" bindtap="removeReceiptAmount">×</button>
          </view>
        </view>

        <button class="add-button hidden-control" bindtap="addReceiptAmount">添加金额项</button>

        <view class="receipt-summary hidden-control">
          <view class="summary-item">
            <view class="summary-value">${{receiptCurrentTotal}}</view>
            <view class="summary-label">当前合计</view>
          </view>
          <view class="summary-item">
            <view class="summary-value">${{receiptTargetDisplay}}</view>
            <view class="summary-label">最终金额</view>
          </view>
          <view class="summary-item">
            <view class="summary-value">{{receiptDifferencePrefix}}${{receiptDifference}}</view>
            <view class="summary-label">差额</view>
          </view>
        </view>

        <view class="receipt-status">{{receiptStatus}}</view>
      </view>
    </view>
  </view>
  </block>
</view>
