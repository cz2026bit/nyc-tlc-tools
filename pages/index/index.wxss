.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.top-band {
  background: #12312b;
  color: #fff;
  padding: 48rpx 32rpx 56rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.45;
}

.search-panel {
  margin: -28rpx 24rpx 24rpx;
  padding: 22rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 32, 28, 0.08);
}

.home-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
  margin: -28rpx 24rpx 24rpx;
}

.feature-card {
  display: grid;
  grid-template-columns: 78rpx 1fr;
  gap: 0 22rpx;
  align-items: center;
  min-height: 190rpx;
  margin: 0;
  padding: 26rpx;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
  background: #fff;
  box-shadow: 0 10rpx 28rpx rgba(16, 32, 28, 0.08);
  text-align: left;
  line-height: 1.35;
}

.feature-icon {
  grid-row: span 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 70rpx;
  height: 70rpx;
  border-radius: 8rpx;
  background: #e6f4ef;
  color: #0f6b56;
  font-size: 34rpx;
  font-weight: 800;
}

.feature-title {
  margin-top: 0;
  color: #13221f;
  font-size: 31rpx;
  font-weight: 800;
}

.feature-desc {
  margin-top: 10rpx;
  color: #68736f;
  font-size: 23rpx;
}

.module-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -28rpx 24rpx 12rpx;
}

.back-button {
  width: 116rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #cbd8d4;
  background: #fff;
  color: #143f37;
  font-size: 24rpx;
  line-height: 64rpx;
}

.module-name {
  color: #fff;
  font-size: 25rpx;
  font-weight: 700;
}

.plate-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plate-input {
  flex: 1;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd8d4;
  border-radius: 6rpx;
  background: #fbfcfc;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.search-button {
  width: 160rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: #0f7b68;
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.hint {
  margin-top: 18rpx;
  color: #6b7672;
  font-size: 23rpx;
  line-height: 1.45;
}

.notice {
  margin: 20rpx 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.error {
  background: #fff0ed;
  color: #9b2c1f;
  border: 1rpx solid #f1b5aa;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 22rpx 24rpx;
}

.summary-item {
  padding: 22rpx 12rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #12312b;
}

.summary-label {
  margin-top: 6rpx;
  color: #68736f;
  font-size: 22rpx;
}

.section {
  margin: 30rpx 24rpx 0;
}

.section-title {
  margin: 0 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #13221f;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-subtitle {
  margin-top: 6rpx;
  color: #68736f;
  font-size: 23rpx;
}

.status {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.status-active {
  background: #e6f4ef;
  color: #0f6b56;
}

.status-other {
  background: #edf0f1;
  color: #4f5b58;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx 22rpx;
  margin-top: 24rpx;
}

.info-label {
  color: #73807b;
  font-size: 21rpx;
}

.info-value {
  margin-top: 5rpx;
  color: #1b2b28;
  font-size: 25rpx;
  line-height: 1.35;
  word-break: break-word;
}

.violation-card {
  border-left: 8rpx solid #d59b2d;
}

.money {
  flex-shrink: 0;
  color: #9b4d00;
  font-size: 31rpx;
  font-weight: 700;
}

.detail-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #edf1ef;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 0;
  color: #243632;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-row text:first-child {
  flex-shrink: 0;
  color: #73807b;
}

.detail-row text:last-child {
  text-align: right;
}

.empty {
  margin: 54rpx 32rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  color: #6b7672;
}

.empty-title {
  color: #243632;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}

.receipt-card {
  border-left: 8rpx solid #0f7b68;
}

.receipt-section {
  margin-top: 16rpx;
}

.mini-button {
  flex-shrink: 0;
  width: 116rpx;
  height: 64rpx;
  margin: 0;
  padding: 0;
  background: #143f37;
  color: #fff;
  font-size: 24rpx;
  line-height: 64rpx;
}

.receipt-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 360rpx;
  margin-top: 24rpx;
  overflow: hidden;
  border: 1rpx dashed #b8c7c2;
  border-radius: 8rpx;
  background: #f8faf9;
  color: #73807b;
  text-align: center;
  font-size: 24rpx;
  line-height: 1.45;
}

.receipt-image-wrap {
  position: relative;
  width: 100%;
}

.receipt-image {
  width: 100%;
  height: 520rpx;
}

.receipt-overlay {
  position: absolute;
  left: 58%;
  top: 72%;
  min-width: 180rpx;
  padding: 14rpx 18rpx;
  border: 1rpx solid rgba(19, 34, 31, 0.2);
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.94);
  color: #111;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1;
  text-align: center;
  transform: translate(-50%, -50%);
  box-shadow: 0 8rpx 20rpx rgba(16, 32, 28, 0.14);
  white-space: pre-line;
}

.receipt-watermark {
  position: absolute;
  left: 50%;
  top: 50%;
  color: rgba(19, 49, 43, 0.18);
  font-size: 58rpx;
  font-weight: 900;
  transform: translate(-50%, -50%) rotate(-18deg);
  white-space: nowrap;
}

.receipt-placeholder {
  padding: 24rpx;
}

.receipt-form {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #53605c;
  font-size: 23rpx;
  font-weight: 700;
}

.target-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.single-target-row {
  display: block;
}

.money-input {
  flex: 1;
  height: 78rpx;
  padding: 0 18rpx;
  border: 1rpx solid #cbd8d4;
  border-radius: 6rpx;
  background: #fbfcfc;
  font-size: 28rpx;
  font-weight: 700;
}

.adjust-button {
  flex-shrink: 0;
  width: 170rpx;
  height: 78rpx;
  margin: 0;
  padding: 0;
  background: #0f7b68;
  color: #fff;
  font-size: 25rpx;
  line-height: 78rpx;
}

.amount-list {
  margin-top: 22rpx;
}

.amount-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.amount-index {
  width: 36rpx;
  color: #73807b;
  font-size: 23rpx;
  text-align: center;
}

.remove-button {
  flex-shrink: 0;
  width: 68rpx;
  height: 68rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid #e1c3bb;
  background: #fff8f6;
  color: #9b2c1f;
  font-size: 34rpx;
  line-height: 68rpx;
}

.add-button {
  width: 100%;
  height: 76rpx;
  margin: 6rpx 0 0;
  padding: 0;
  border: 1rpx solid #cbd8d4;
  background: #fff;
  color: #143f37;
  font-size: 25rpx;
  line-height: 76rpx;
}

.receipt-summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 22rpx;
}

.receipt-status {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 8rpx;
  background: #eef8f5;
  color: #0f6b56;
  font-size: 24rpx;
  line-height: 1.45;
}

.hidden-control {
  display: none;
}
