.page {
  min-height: 100vh;
  padding-bottom: 48rpx;
}

.top-band {
  background: #12312b;
  color: #fff;
  padding: 48rpx 32rpx 56rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 26rpx;
  line-height: 1.45;
}

.search-panel {
  margin: -28rpx 24rpx 24rpx;
  padding: 22rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
  box-shadow: 0 10rpx 28rpx rgba(16, 32, 28, 0.08);
}

.plate-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.plate-input {
  flex: 1;
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #cbd8d4;
  border-radius: 6rpx;
  background: #fbfcfc;
  font-size: 32rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.search-button {
  width: 160rpx;
  height: 88rpx;
  margin: 0;
  padding: 0;
  background: #0f7b68;
  color: #fff;
  font-size: 30rpx;
  line-height: 88rpx;
}

.hint {
  margin-top: 18rpx;
  color: #6b7672;
  font-size: 23rpx;
  line-height: 1.45;
}

.notice {
  margin: 20rpx 24rpx;
  padding: 22rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.error {
  background: #fff0ed;
  color: #9b2c1f;
  border: 1rpx solid #f1b5aa;
}

.summary {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin: 22rpx 24rpx;
}

.summary-item {
  padding: 22rpx 12rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
  text-align: center;
}

.summary-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #12312b;
}

.summary-label {
  margin-top: 6rpx;
  color: #68736f;
  font-size: 22rpx;
}

.section {
  margin: 30rpx 24rpx 0;
}

.section-title {
  margin: 0 4rpx 16rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.card {
  margin-bottom: 18rpx;
  padding: 24rpx;
  background: #fff;
  border: 1rpx solid #dde5e2;
  border-radius: 8rpx;
}

.card-head {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  color: #13221f;
  font-size: 31rpx;
  font-weight: 700;
  line-height: 1.3;
}

.card-subtitle {
  margin-top: 6rpx;
  color: #68736f;
  font-size: 23rpx;
}

.status {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  font-size: 22rpx;
  line-height: 44rpx;
}

.status-active {
  background: #e6f4ef;
  color: #0f6b56;
}

.status-other {
  background: #edf0f1;
  color: #4f5b58;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx 22rpx;
  margin-top: 24rpx;
}

.info-label {
  color: #73807b;
  font-size: 21rpx;
}

.info-value {
  margin-top: 5rpx;
  color: #1b2b28;
  font-size: 25rpx;
  line-height: 1.35;
  word-break: break-word;
}

.violation-card {
  border-left: 8rpx solid #d59b2d;
}

.money {
  flex-shrink: 0;
  color: #9b4d00;
  font-size: 31rpx;
  font-weight: 700;
}

.detail-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #edf1ef;
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 16rpx 0 0;
  color: #243632;
  font-size: 24rpx;
  line-height: 1.45;
}

.detail-row text:first-child {
  flex-shrink: 0;
  color: #73807b;
}

.detail-row text:last-child {
  text-align: right;
}

.empty {
  margin: 54rpx 32rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  color: #6b7672;
}

.empty-title {
  color: #243632;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
}
